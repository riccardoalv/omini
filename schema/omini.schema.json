{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riccardoalv/omini/schema/omini.schema.json",
  "title": "Omini data contract",
  "description": "Single source of truth for the data exchanged between the Omini core and integrations/plugins. Go types and Python models are generated from this file (make generate).",
  "$defs": {
    "Device": {
      "type": "object",
      "description": "Vendor-neutral snapshot of one network device, as collected by an integration.",
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Stable unique id of the device within its integration (e.g. base MAC or serial)."
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "description": "Management IP or hostname."
        },
        "role": {
          "$ref": "#/$defs/DeviceRole"
        },
        "vendor": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mem_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical CPUs (cores or threads); for a virtual machine or container, its vCPUs."
        },
        "mem_total_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Memory installed (or given to a virtual machine or container)."
        },
        "mem_used_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Memory in use."
        },
        "swap_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Swap in use."
        },
        "load_avg": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "description": "System load averages over 1, 5 and 15 minutes."
        },
        "temperatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Temperature"
          },
          "description": "Temperature sensors (CPU cores, disks, board)."
        },
        "storage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Storage"
          },
          "description": "Mounted file systems / volumes."
        },
        "firmware": {
          "$ref": "#/$defs/Firmware"
        },
        "macs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MacAddress"
          },
          "description": "All MAC addresses owned by the device."
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All IP addresses owned by the device."
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interface"
          }
        },
        "neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Neighbor"
          }
        },
        "fdb": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FdbEntry"
          }
        },
        "arp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArpEntry"
          }
        },
        "ndp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArpEntry"
          },
          "description": "IPv6 neighbors (NDP): which MAC each IPv6 address belongs to, so flows over IPv6 reach the right device."
        },
        "dhcp_leases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DhcpLease"
          }
        },
        "wireless_clients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WirelessClient"
          }
        },
        "gateways": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gateway"
          },
          "description": "Upstream gateways monitored by a router or firewall."
        },
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Host"
          },
          "description": "End devices observed by this integration with extra details (network scans, controllers)."
        },
        "vlans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Vlan"
          },
          "description": "VLANs defined on the device."
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Network"
          },
          "description": "Networks the router serves (each VLAN's interface, gateway, DHCP and access); VLAN 1 is the untagged LAN."
        },
        "wifi_networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WifiNetwork"
          },
          "description": "Wi-Fi networks the device (an access point, or a controller for its site) broadcasts, with their VLAN."
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          },
          "description": "Services running (or stopped) on the device."
        },
        "vpn_peers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VpnPeer"
          },
          "description": "VPN tunnels and peers."
        },
        "dhcp_pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DhcpPool"
          },
          "description": "Usage of each DHCP range."
        },
        "dhcp_reservations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DhcpReservation"
          },
          "description": "Fixed addresses the DHCP server hands out (reservations)."
        },
        "dhcp_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DhcpCheck"
          },
          "description": "DHCP checks on this network (network scan): what answered a DHCPDISCOVER."
        },
        "dns_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DnsCheck"
          },
          "description": "DNS checks of the servers of this network (network scan)."
        },
        "firewall_states": {
          "$ref": "#/$defs/FirewallStates"
        },
        "dns_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DnsRecord"
          },
          "description": "Local DNS names the device (a DNS server or router) answers, set by hand or by Omini."
        },
        "dns_lookups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DnsLookup"
          },
          "description": "Recent DNS lookups the device (a DNS server) answered: which client asked for which name, and the addresses it got. Omini uses them to name where devices go and keeps them in memory only."
        },
        "dns_domain": {
          "type": "string",
          "description": "The local domain the device hands out or answers for (e.g. \"home.arpa\"), when it has one."
        },
        "paused": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PausedDevice"
          },
          "description": "Devices whose internet the router cuts (pause.set)."
        },
        "stp_root": {
          "type": "string",
          "description": "Bridge ID of the spanning tree root as the device sees it (e.g. \"32768.aa:bb:cc:dd:ee:ff\")."
        }
      }
    },
    "DeviceRole": {
      "type": "string",
      "enum": [
        "router",
        "switch",
        "ap",
        "firewall",
        "server",
        "unknown"
      ]
    },
    "MacAddress": {
      "type": "string",
      "description": "Lowercase, colon separated: aa:bb:cc:dd:ee:ff.",
      "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
    },
    "Interface": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Readable port name (ifName), never a numeric index."
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/InterfaceType"
        },
        "connector": {
          "$ref": "#/$defs/InterfaceConnector"
        },
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Addresses assigned to the interface, with prefix length (192.168.1.1/24)."
        },
        "wan": {
          "type": "boolean",
          "description": "Uplink to the internet (a WAN of a router or firewall)."
        },
        "parent": {
          "type": "string",
          "description": "Interface this one runs on: a VLAN's port, the port carrying a PPPoE link."
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ports a bridge or LAG is made of, by interface name."
        },
        "up": {
          "type": "boolean",
          "description": "Operational status."
        },
        "enabled": {
          "type": "boolean",
          "description": "Administrative status: false when the port is disabled in the device's configuration."
        },
        "speed_mbps": {
          "type": "integer",
          "minimum": 0
        },
        "duplex": {
          "type": "string",
          "enum": [
            "full",
            "half"
          ]
        },
        "media": {
          "type": "string",
          "description": "Negotiated media as reported by the device, e.g. \"1000baseT <full-duplex>\"."
        },
        "rx_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative counter."
        },
        "tx_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Cumulative counter."
        },
        "rx_errors": {
          "type": "integer",
          "minimum": 0
        },
        "tx_errors": {
          "type": "integer",
          "minimum": 0
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094,
          "description": "VLAN id of a VLAN interface (e.g. igc1.20 → 20)."
        },
        "vlans": {
          "$ref": "#/$defs/PortVlans"
        },
        "transceiver": {
          "$ref": "#/$defs/Transceiver"
        },
        "stp": {
          "$ref": "#/$defs/PortStp"
        },
        "lag": {
          "type": "string",
          "description": "Name of the LAG (bond, aggregate) this port is a member of."
        }
      }
    },
    "InterfaceType": {
      "type": "string",
      "enum": [
        "ethernet",
        "wireless",
        "bridge",
        "vlan",
        "lag",
        "loopback",
        "tunnel",
        "other"
      ]
    },
    "InterfaceConnector": {
      "type": "string",
      "description": "Physical connector of a port.",
      "enum": [
        "rj45",
        "sfp",
        "qsfp"
      ]
    },
    "Neighbor": {
      "type": "object",
      "description": "A device seen through a discovery protocol.",
      "required": [
        "local_port"
      ],
      "additionalProperties": false,
      "properties": {
        "local_port": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/NeighborProtocol"
        },
        "remote_name": {
          "type": "string"
        },
        "remote_port": {
          "type": "string"
        },
        "remote_mac": {
          "$ref": "#/$defs/MacAddress",
          "description": "Chassis MAC, when the chassis id is a MAC."
        },
        "remote_ip": {
          "type": "string"
        },
        "remote_platform": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "description": "What the neighbor says it is (LLDP enabled capabilities): a desk phone announces telephone, a switch bridge.",
          "items": {
            "$ref": "#/$defs/NeighborCapability"
          }
        }
      }
    },
    "NeighborCapability": {
      "type": "string",
      "enum": [
        "other",
        "repeater",
        "bridge",
        "ap",
        "router",
        "telephone",
        "docsis",
        "station"
      ]
    },
    "FdbEntry": {
      "type": "object",
      "description": "Switch forwarding table entry: this MAC was learned on this port.",
      "required": [
        "mac",
        "port"
      ],
      "additionalProperties": false,
      "properties": {
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "port": {
          "type": "string"
        },
        "vlan": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    },
    "ArpEntry": {
      "type": "object",
      "required": [
        "ip",
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string"
        },
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "interface": {
          "type": "string"
        }
      }
    },
    "DhcpLease": {
      "type": "object",
      "required": [
        "ip",
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string"
        },
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "hostname": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "WirelessClient": {
      "type": "object",
      "required": [
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "interface": {
          "type": "string"
        },
        "ssid": {
          "type": "string"
        },
        "band": {
          "$ref": "#/$defs/WifiBand"
        },
        "signal_dbm": {
          "type": "integer",
          "maximum": 0
        },
        "tx_rate_mbps": {
          "type": "number",
          "minimum": 0,
          "description": "Link (PHY) rate from the access point to the client."
        },
        "rx_rate_mbps": {
          "type": "number",
          "minimum": 0,
          "description": "Link (PHY) rate from the client to the access point."
        },
        "rx_bps": {
          "type": "integer",
          "minimum": 0,
          "description": "Current traffic the client downloads, in bits per second, as the access point measures it."
        },
        "tx_bps": {
          "type": "integer",
          "minimum": 0,
          "description": "Current traffic the client uploads, in bits per second."
        }
      }
    },
    "Gateway": {
      "type": "object",
      "description": "A gateway monitored by a router or firewall (e.g. WAN uplinks).",
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "interface": {
          "type": "string",
          "description": "Interface the gateway is reached through."
        },
        "address": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GatewayStatus"
        },
        "rtt_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Average round-trip time."
        },
        "loss_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "GatewayStatus": {
      "type": "string",
      "enum": [
        "up",
        "degraded",
        "down",
        "unknown"
      ]
    },
    "FormField": {
      "type": "object",
      "description": "One input of the 'add integration' form. Declared by core integrations and in plugin.yaml.",
      "required": [
        "key",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "$ref": "#/$defs/FormFieldType"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "Default value; type must match the field type."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Choices for 'select' fields."
        },
        "group": {
          "type": "string",
          "description": "Section the field is shown under (e.g. \"Methods\"); fields without a group come first."
        }
      }
    },
    "PluginManifest": {
      "type": "object",
      "description": "Contents of plugin.yaml at the root of a plugin repository.",
      "required": [
        "id",
        "name",
        "version",
        "protocol",
        "entrypoint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the plugin."
        },
        "protocol": {
          "type": "integer",
          "minimum": 1,
          "description": "Plugin protocol version implemented by the plugin."
        },
        "entrypoint": {
          "type": "string",
          "description": "Python file executed by the core, relative to the plugin root."
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "description": "Time limit per run; default 60."
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FormField"
          }
        },
        "changes": {
          "type": "array",
          "description": "Configuration changes the plugin can apply (action apply).",
          "items": {
            "$ref": "#/$defs/ChangeKind"
          }
        },
        "backup": {
          "type": "boolean",
          "description": "The plugin answers the backup action: each device's configuration as readable text."
        }
      }
    },
    "ChangeKind": {
      "type": "string",
      "description": "A configuration change Omini knows. port.enabled: enable (true) or disable (false) a port. port.vlans: the port's VLANs, a PortVlans (access: untagged only; trunk: untagged as the native VLAN, or none, and the tagged list), only VLANs the device has. vlan.set: create a VLAN on the device, or rename it ({id, name}). vlan.delete: delete a VLAN from the device ({id}). network.set: create or change a VLAN's network on the router (a Network: interface, gateway, DHCP, access, mDNS). network.delete: remove it ({vlan}). reservation.set: a fixed address for a MAC on the router's DHCP (a DhcpReservation). reservation.delete: remove it ({mac}). wifi.set: create or change a Wi-Fi network (a WifiChange: its name, VLAN, password, on or off). wifi.delete: remove it ({ssid}). dns.set: a local DNS name for an address ({name, ip}, name fully qualified). dns.delete: remove it ({name}). wol.send: wake a device with a magic packet, sent by the router on the network that holds ip ({mac, ip}). pause.set: cut a device's internet on the router (a PausedDevice); its own network stays reachable. pause.delete: give it back ({mac}).",
      "enum": [
        "port.enabled",
        "port.vlans",
        "vlan.set",
        "vlan.delete",
        "network.set",
        "network.delete",
        "reservation.set",
        "reservation.delete",
        "wifi.set",
        "wifi.delete",
        "dns.set",
        "dns.delete",
        "wol.send",
        "pause.set",
        "pause.delete"
      ]
    },
    "Change": {
      "type": "object",
      "description": "One configuration change to apply to a device.",
      "required": [
        "device",
        "kind",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "string",
          "description": "Key of the device, as the plugin reported it."
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "port": {
          "type": "string",
          "description": "Interface name, for the changes of a port."
        },
        "value": {
          "description": "The new value: a boolean for port.enabled, a PortVlans object for port.vlans, {id, name} for vlan.set, {id} for vlan.delete, a Network for network.set, {vlan} for network.delete, a DhcpReservation for reservation.set, {mac} for reservation.delete, a WifiChange for wifi.set, {ssid} for wifi.delete."
        }
      }
    },
    "PluginRequest": {
      "type": "object",
      "description": "Written by the core as JSON to the plugin's stdin.",
      "required": [
        "protocol",
        "action",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "$ref": "#/$defs/PluginAction"
        },
        "config": {
          "type": "object",
          "description": "Values of the manifest fields, keyed by field key.",
          "additionalProperties": true
        },
        "state_dir": {
          "type": "string",
          "description": "Writable directory private to this integration, kept between runs (e.g. to cache sessions)."
        },
        "change": {
          "$ref": "#/$defs/Change",
          "description": "The change to apply (action apply only)."
        }
      }
    },
    "PluginResponse": {
      "type": "object",
      "description": "Written by the plugin as JSON to stdout. Exactly one of devices (collect, apply), message (test), backups (backup) or error is set.",
      "additionalProperties": false,
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        },
        "message": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "backups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigBackup"
          },
          "description": "The backup action: one per device the integration reads (a controller has several)."
        }
      }
    },
    "NeighborProtocol": {
      "type": "string",
      "enum": [
        "lldp",
        "cdp",
        "mndp",
        "other"
      ]
    },
    "WifiBand": {
      "type": "string",
      "enum": [
        "2.4ghz",
        "5ghz",
        "6ghz"
      ]
    },
    "FormFieldType": {
      "type": "string",
      "enum": [
        "string",
        "secret",
        "host",
        "url",
        "int",
        "bool",
        "select"
      ]
    },
    "PluginAction": {
      "type": "string",
      "enum": [
        "collect",
        "test",
        "apply",
        "backup"
      ]
    },
    "Host": {
      "type": "object",
      "description": "An end device observed on the network, with whatever could be learned about it.",
      "required": [
        "ip"
      ],
      "additionalProperties": false,
      "properties": {
        "ip": {
          "type": "string"
        },
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names from DNS, mDNS, NetBIOS, DHCP..."
        },
        "vendor": {
          "type": "string",
          "description": "Hardware vendor (e.g. from the MAC prefix)."
        },
        "manufacturer": {
          "type": "string",
          "description": "Manufacturer reported by the device itself (UPnP)."
        },
        "model": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "open_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Advertised services, e.g. mDNS types like _airplay._tcp."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "How the host was found: arp, icmp, tcp, dns, mdns, ssdp, netbios, snmp."
        },
        "titles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Titles of the web interfaces found on the host (e.g. \"TrueNAS\", \"Proxmox Virtual Environment\")."
        },
        "ttl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "TTL of ICMP replies: hints the OS family (64 Unix-like, 128 Windows, 255 network gear)."
        },
        "banners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Service banners, e.g. the SSH version string."
        },
        "web": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WebService"
          },
          "description": "Web interfaces found on the host, one per port."
        },
        "dhcp": {
          "$ref": "#/$defs/DhcpFingerprint"
        }
      }
    },
    "DhcpFingerprint": {
      "type": "object",
      "description": "What a device asks for when it requests an address (DHCP): the options it wants, in its own order, and what it says it is. Hints its operating system.",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "string",
          "description": "Option 55, the parameter request list, e.g. \"1,3,6,15,31,33,43,44,46,47,119,121,249,252\"."
        },
        "vendor_class": {
          "type": "string",
          "description": "Option 60, the vendor class identifier, e.g. \"android-dhcp-14\" or \"MSFT 5.0\"."
        },
        "hostname": {
          "type": "string",
          "description": "Option 12, the name the device gives itself."
        }
      }
    },
    "WebService": {
      "type": "object",
      "description": "A web interface found on a host.",
      "required": [
        "port",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "Temperature": {
      "type": "object",
      "description": "One temperature sensor.",
      "required": [
        "sensor",
        "celsius"
      ],
      "additionalProperties": false,
      "properties": {
        "sensor": {
          "type": "string",
          "description": "Readable sensor name, e.g. \"CPU 0\", \"ada0\"."
        },
        "kind": {
          "type": "string",
          "enum": [
            "cpu",
            "disk",
            "board",
            "other"
          ]
        },
        "celsius": {
          "type": "number"
        }
      }
    },
    "Storage": {
      "type": "object",
      "description": "A mounted file system or volume.",
      "required": [
        "mount"
      ],
      "additionalProperties": false,
      "properties": {
        "mount": {
          "type": "string",
          "description": "Mount point, e.g. \"/\"."
        },
        "device": {
          "type": "string"
        },
        "fs_type": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Firmware": {
      "type": "object",
      "description": "Installed software/firmware version and available updates, as last checked by the device.",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "string"
        },
        "latest": {
          "type": "string",
          "description": "Newest version the device knows about."
        },
        "update_available": {
          "type": "boolean"
        },
        "updates": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of pending package/firmware updates."
        },
        "needs_reboot": {
          "type": "boolean",
          "description": "Installing the updates requires a reboot."
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the device last checked for updates; absent if it never did."
        }
      }
    },
    "PortVlans": {
      "type": "object",
      "description": "VLAN membership of a switch port.",
      "additionalProperties": false,
      "properties": {
        "untagged": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094,
          "description": "VLAN of untagged frames (PVID / access VLAN)."
        },
        "tagged": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4094
          },
          "description": "VLANs carried tagged (trunk)."
        }
      }
    },
    "Transceiver": {
      "type": "object",
      "description": "A pluggable optic or DAC (SFP, SFP+, QSFP...) and its diagnostics (DOM / DDM), when the device reads them.",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": "string"
        },
        "part": {
          "type": "string",
          "description": "Part number."
        },
        "serial": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "e.g. \"10GBASE-SR\", \"1000BASE-LX\", \"DAC\"."
        },
        "wavelength_nm": {
          "type": "number",
          "minimum": 0
        },
        "temperature_c": {
          "type": "number",
          "description": "Module temperature."
        },
        "voltage_v": {
          "type": "number",
          "description": "Supply voltage."
        },
        "bias_ma": {
          "type": "number",
          "description": "Laser bias current."
        },
        "tx_power_dbm": {
          "type": "number",
          "description": "Transmitted optical power."
        },
        "rx_power_dbm": {
          "type": "number",
          "description": "Received optical power."
        },
        "rx_power_low_dbm": {
          "type": "number",
          "description": "Receive power alarm threshold (low), when the module reports it."
        },
        "temperature_high_c": {
          "type": "number",
          "description": "Module temperature alarm threshold (high), when the module reports it."
        }
      }
    },
    "Vlan": {
      "type": "object",
      "description": "A VLAN defined on the device.",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "name": {
          "type": "string"
        },
        "interface": {
          "type": "string",
          "description": "The device's interface for this VLAN, if any (router/firewall)."
        },
        "subnet": {
          "type": "string",
          "description": "e.g. \"192.168.20.0/24\"."
        }
      }
    },
    "Network": {
      "type": "object",
      "description": "A VLAN's network on a router: its interface, gateway, DHCP range, access and discovery.",
      "required": [
        "vlan"
      ],
      "additionalProperties": false,
      "properties": {
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094,
          "description": "The VLAN; 1 is the untagged LAN."
        },
        "name": {
          "type": "string",
          "description": "The interface's description (\"IOT\")."
        },
        "interface": {
          "type": "string",
          "description": "The router's name for the interface (\"lan\", \"opt3\"), empty when the router has none yet."
        },
        "device": {
          "type": "string",
          "description": "Its device (\"vlan0.30\", \"igb1\")."
        },
        "parent": {
          "type": "string",
          "description": "The port the VLAN rides on (\"igb1\"); empty: the router's port toward the switches."
        },
        "gateway": {
          "type": "string",
          "description": "The router's address with the prefix, e.g. \"192.168.30.1/24\"."
        },
        "dhcp": {
          "$ref": "#/$defs/NetworkDhcp"
        },
        "access": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "mdns": {
          "type": "boolean",
          "description": "Discovery (mDNS) repeated to and from the other networks that have it."
        }
      }
    },
    "NetworkDhcp": {
      "type": "object",
      "description": "A network's DHCP: on or off and its range.",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "string",
          "description": "First address of the range."
        },
        "to": {
          "type": "string",
          "description": "Last address of the range."
        },
        "reserve_in_range": {
          "type": "boolean",
          "description": "false: the router refuses a reservation (fixed address) inside the range; absent: it accepts one."
        }
      }
    },
    "NetworkAccess": {
      "type": "string",
      "description": "What a network reaches through the router. internet: the internet, no other network. all: the internet and every other network. local: its own network only. custom: rules set by hand that are none of these (reported only, never set).",
      "enum": [
        "internet",
        "all",
        "local",
        "custom"
      ]
    },
    "WifiNetwork": {
      "type": "object",
      "description": "A Wi-Fi network (SSID) and the VLAN it puts its clients in.",
      "required": [
        "ssid"
      ],
      "additionalProperties": false,
      "properties": {
        "ssid": {
          "type": "string"
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094,
          "description": "The VLAN of its clients; empty: the untagged LAN."
        },
        "security": {
          "type": "string",
          "enum": [
            "open",
            "wpa2",
            "wpa3",
            "wpa2wpa3"
          ],
          "description": "How it is secured."
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "WifiChange": {
      "type": "object",
      "description": "A Wi-Fi network to create or change (wifi.set). previous renames one; an empty password keeps the current one.",
      "required": [
        "ssid"
      ],
      "additionalProperties": false,
      "properties": {
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "previous": {
          "type": "string",
          "description": "Its current name, when it is renamed."
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "password": {
          "type": "string",
          "description": "WPA2 passphrase, 8 to 63 characters; empty keeps the current one. Never kept in Omini."
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "Service": {
      "type": "object",
      "description": "A service (daemon) running on the device.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean",
          "description": "Configured to run (a stopped enabled service is a problem)."
        }
      }
    },
    "VpnPeer": {
      "type": "object",
      "description": "A VPN tunnel or peer (WireGuard peer, OpenVPN client, IPsec tunnel).",
      "required": [
        "name",
        "protocol"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "wireguard",
            "openvpn",
            "ipsec",
            "other"
          ]
        },
        "endpoint": {
          "type": "string",
          "description": "Remote address (host:port)."
        },
        "address": {
          "type": "string",
          "description": "Tunnel address(es) of the peer."
        },
        "connected": {
          "type": "boolean"
        },
        "last_handshake": {
          "type": "string",
          "format": "date-time"
        },
        "rx_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tx_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DhcpPool": {
      "type": "object",
      "description": "Usage of a DHCP range.",
      "required": [
        "network"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "string",
          "description": "Interface or subnet the range serves, e.g. \"LAN\", \"192.168.1.0/24\"."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Addresses in the range."
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "description": "Active leases."
        }
      }
    },
    "DhcpReservation": {
      "type": "object",
      "description": "A fixed address the DHCP server hands out to one MAC.",
      "required": [
        "mac",
        "ip"
      ],
      "additionalProperties": false,
      "properties": {
        "mac": {
          "$ref": "#/$defs/MACAddress"
        },
        "ip": {
          "type": "string",
          "description": "IPv4 address."
        },
        "name": {
          "type": "string",
          "description": "Host name given with it."
        }
      }
    },
    "FirewallStates": {
      "type": "object",
      "description": "Connection tracking table of a firewall.",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "DhcpCheck": {
      "type": "object",
      "description": "A DHCPDISCOVER sent on one interface and the offers that came back (no address is taken).",
      "required": [
        "interface"
      ],
      "additionalProperties": false,
      "properties": {
        "interface": {
          "type": "string"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DhcpOffer"
          }
        },
        "error": {
          "type": "string",
          "description": "Why the check could not run (then nothing is known about the servers)."
        }
      }
    },
    "DhcpOffer": {
      "type": "object",
      "description": "An answer to the DHCPDISCOVER.",
      "required": [
        "server_ip"
      ],
      "additionalProperties": false,
      "properties": {
        "server_ip": {
          "type": "string",
          "description": "The server identifier (option 54), else the sender."
        },
        "server_mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "offered_ip": {
          "type": "string"
        },
        "routers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "DNS servers it hands out (option 6)."
        },
        "domain": {
          "type": "string"
        },
        "lease_s": {
          "type": "integer",
          "minimum": 0
        },
        "rtt_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "DnsCheck": {
      "type": "object",
      "description": "A DNS server and the test queries it answered.",
      "required": [
        "server"
      ],
      "additionalProperties": false,
      "properties": {
        "server": {
          "type": "string"
        },
        "external": {
          "$ref": "#/$defs/DnsQuery"
        },
        "local": {
          "$ref": "#/$defs/DnsQuery"
        }
      }
    },
    "DnsQuery": {
      "type": "object",
      "description": "One test query.",
      "required": [
        "name",
        "ok"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean",
          "description": "The name resolved."
        },
        "rtt_ms": {
          "type": "number",
          "minimum": 0
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string",
          "description": "\"timeout\", \"refused\", \"not found\" or what the resolver said."
        }
      }
    },
    "DnsRecord": {
      "type": "object",
      "description": "A local DNS name.",
      "required": [
        "name",
        "ip"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Fully qualified, e.g. \"nas.home.arpa\"."
        },
        "ip": {
          "type": "string"
        }
      }
    },
    "PausedDevice": {
      "type": "object",
      "description": "A device whose internet the router cuts.",
      "required": [
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "mac": {
          "$ref": "#/$defs/MacAddress"
        },
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its current addresses, which the router blocks."
        },
        "name": {
          "type": "string"
        },
        "rule": {
          "type": "string",
          "description": "Empty when Omini paused it; otherwise the router rule, set by hand, that blocks it (resuming turns that rule off)."
        }
      }
    },
    "PortStp": {
      "type": "object",
      "description": "A port's spanning tree state and role.",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "forwarding",
            "blocking",
            "listening",
            "learning",
            "disabled"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "root",
            "designated",
            "alternate",
            "backup",
            "disabled"
          ]
        }
      }
    },
    "ConfigBackup": {
      "type": "object",
      "description": "A device's configuration as readable text, for history and differences (never restored).",
      "required": [
        "device",
        "format",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json",
            "xml"
          ]
        },
        "content": {
          "type": "string"
        },
        "device": {
          "type": "string",
          "description": "Key of the device it belongs to, as collect reports it."
        }
      }
    },
    "DnsLookup": {
      "type": "object",
      "required": [
        "client",
        "domain"
      ],
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string",
          "description": "The address of the device that asked."
        },
        "domain": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The A and AAAA addresses in the answer, when the server logs them."
        }
      }
    }
  }
}
